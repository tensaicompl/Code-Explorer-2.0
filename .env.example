# Praxevia Explorer — environment template.
#
#   cp .env.example .env    then fill in the REQUIRED values below.
#
# `.env` is gitignored. `.env.example` is committed and MUST NOT contain a real
# secret: the indexer treats dotenv files as source, and while it redacts values
# before they reach the search index, a secret committed here is a secret in the
# Git history forever.
#
# Copyright (c) 2026 Praxevia. Proprietary — see LICENSE.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Sign-in for the dashboard. There is NO DEFAULT: the backend refuses to start
# without these, deliberately. An earlier version defaulted to a password that
# was committed in this repository, which on any reachable host is an open door
# with a publicly known key.
#
# This is a single shared development credential, not an identity system.
# Production identity is Entra ID / MSAL and is NOT yet ported — do not expose
# this service to an untrusted network while that remains true.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Where the source trees to index live, as {project}/{stream}/ subdirectories:
#   ${CODEBASE_DIR}/myproject/main/...
# Inside Docker Compose this is bind-mounted to /data/codebase; set the HOST
# path here.
CODEBASE_DIR=./codebase

# ─── CHAT (optional — everything else works without it) ──────────────────────

# Without a key the graph, search and all panels work; the chat dock returns 503
# and says so. Any Anthropic-compatible provider works, because the SDK reads
# ANTHROPIC_BASE_URL itself — verified against a non-Anthropic gateway.
ANTHROPIC_API_KEY=

# Leave unset for the Anthropic API. Set it to point at a compatible gateway.
# ANTHROPIC_BASE_URL=https://api.example.com/anthropic

# The model the chat defaults to. The dashboard's picker can override it per
# question, within the backend's ALLOWED_MODELS.
CLAUDE_MODEL=claude-opus-5

# ─── STORAGE ─────────────────────────────────────────────────────────────────

# Read by the backend and the indexer. The Compose default already points at the
# `postgres` service; override only when using an external database.
# DATABASE_URL=postgresql://prx:prx@postgres:5432/prx

# Where graph_pass.builder writes graphs and the graph API reads them. Both
# sides read this one variable so they cannot drift apart.
GRAPH_DIR=./.graphs

# ─── INDEXING (tune only if you hit a limit) ─────────────────────────────────

# Embeddings run on CPU inside the container: a 2 000-file repository took
# roughly two hours cold. Re-indexing is incremental and fast. On Apple silicon,
# indexer/run_native.sh uses MPS instead and is far quicker.
# EMBEDDING_MODEL=Alibaba-NLP/gte-base-en-v1.5
# EMBED_BATCH_SIZE=128
# MAX_DATA_FILE_SIZE=1048576
# MAX_SOURCE_FILE_SIZE=5242880

# ─── OPTIONAL INTEGRATIONS ───────────────────────────────────────────────────

# Entra ID login (production identity — not yet ported;.
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=

# Claude via Azure AI Foundry instead of the Anthropic API.
# USE_AZURE_AI=false
# AZURE_AI_TENANT_ID=
# AZURE_AI_CLIENT_ID=
# AZURE_AI_CLIENT_SECRET=
# AZURE_AI_RESOURCE=
# AZURE_AI_BASE_URL=

# Read-only context enrichment. Confluence is live; Jira is shipped on the
# backend and dead on the frontend.
# JIRA_SERVICE_TOKEN=
# CONFLUENCE_TOKEN=

# Machine access for CI or monitoring: comma-separated "key:client_name" pairs.
# API_KEYS=

# ─── E2E TESTS (only needed to run e2e/) ─────────────────────────────────────

# e2e/run.py starts the backend and dashboard itself. It needs to know where the
# source trees are; it has no built-in default and will tell you to set this.
# E2E_CODEBASE_DIR=./codebase
# E2E_INDEXER_DIR=.

# ---------------------------------------------------------------------------
# Credential encryption
# ---------------------------------------------------------------------------
# 64 hex characters (32 bytes) for AES-256-GCM. Leave unset and git tokens and
# SSH keys are written to the database in clear text -- the backend says so at
# startup rather than failing. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it makes every already-encrypted secret unreadable.
# PRX_CREDENTIAL_KEY=

# ---------------------------------------------------------------------------
# Issue tracker and wiki enrichment (optional)
# ---------------------------------------------------------------------------
# Point these at your own instances to have links pasted into a chat message
# resolved and their content pulled in as context. Both are empty by default and
# no site is compiled into the source: with nothing set here, link enrichment
# simply does not run.
# JIRA_SITE_URL=https://jira.example.com
# CONFLUENCE_SITE_URL=https://example.atlassian.net
# Set true once the tracker presents a certificate the container trusts.
# Defaults to false, which is how self-hosted instances usually need it.
# JIRA_VERIFY_SSL=false

# ---------------------------------------------------------------------------
# Internals (rarely changed)
# ---------------------------------------------------------------------------
# Directory the backend drops refresh signals into for the indexer sidecar to
# pick up. Both sides must agree; compose sets it for you.
# PRX_SIGNAL_DIR=/data/shared
# Seconds between keepalive comments on a streaming chat response. Raise it only
# if something between client and server is dropping idle connections.
# PRX_HEARTBEAT_INTERVAL_SECONDS=10

