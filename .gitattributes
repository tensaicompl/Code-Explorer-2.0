* text=auto eol=lf

# Generated parser tables: large, machine-written, never reviewed by hand and never
# edited. Marked -text as well, so hundreds of megabytes are not run through line
# ending normalisation on every checkout.
engine/grammars/**/parser.c linguist-generated=true -diff -text
engine/grammars/**/scanner.c linguist-generated=true -diff -text
engine/grammars/**/*.h linguist-generated=true -diff

# Committed bindings are regenerated by a make target, not edited.
crates/pdx-engine-sys/src/bindings.rs linguist-generated=true -diff

# Binary fixtures.
*.onnx binary
*.scip binary
*.db binary
*.msgpack binary
