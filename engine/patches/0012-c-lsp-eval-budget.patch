+// --- Expression evaluation budget ---
+
+/* Expression type evaluation is bounded per file, so that a pathological input ends
+ * in unknown types instead of hanging indexing. The work an ordinary file needs grows
+ * with its length, so a fixed bound starved large files: one many times the usual
+ * size ran out and lost typed evidence that was there to find. The budget therefore
+ * grows with the length of the source the evaluator runs over, one tranche of steps
+ * for every started tranche of bytes. It never falls below one tranche, so a small
+ * file keeps the protection it always had, and never exceeds the cap, so any input,
+ * adversarial ones included, has a fixed finite ceiling. It depends on the length
+ * alone: every run gives a file the same budget, whatever the machine. Running it out
+ * is lost work (c_eval_expr_type), and the recursion-depth limit is separate. */
+#define C_EVAL_STEPS_PER_TRANCHE 10000
+#define C_EVAL_SOURCE_TRANCHE_BYTES 32768
+#define C_EVAL_MAX_STEP_BUDGET 320000
+
+int c_eval_step_budget_for_source_len(int source_len) {
+    if (source_len <= C_EVAL_SOURCE_TRANCHE_BYTES)
+        return C_EVAL_STEPS_PER_TRANCHE;
+    /* Started tranches by quotient and remainder: no intermediate can overflow. */
+    int tranches = source_len / C_EVAL_SOURCE_TRANCHE_BYTES +
+                   (source_len % C_EVAL_SOURCE_TRANCHE_BYTES != 0 ? 1 : 0);
+    if (tranches >= C_EVAL_MAX_STEP_BUDGET / C_EVAL_STEPS_PER_TRANCHE)
+        return C_EVAL_MAX_STEP_BUDGET;
+    return tranches * C_EVAL_STEPS_PER_TRANCHE;
+}
