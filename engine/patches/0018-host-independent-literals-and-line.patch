+/** The number of a #line or # N "file" directive: the leading decimal digits of the
+ *  token, read at a fixed width and at most 4294967295, the largest line a Location holds
+ *  on every platform. No C long, libc conversion or locale decides it. */
+static unsigned int lineDirectiveNumber(const std::string &number)
+{
+    const unsigned long long maxLine = 0xffffffffULL;
+    unsigned long long value = 0;
+    for (std::string::size_type i = 0; i < number.size() && number[i] >= '0' && number[i] <= '9'; ++i) {
+        value = value * 10 + static_cast<unsigned long long>(number[i] - '0');
+        if (value > maxLine)
+            return static_cast<unsigned int>(maxLine);
+    }
+    return static_cast<unsigned int>(value);
+}
