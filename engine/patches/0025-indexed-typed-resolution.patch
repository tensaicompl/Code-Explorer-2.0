+
+static int match_next(match_iter *it) {
+    const PDXETypeRegistry *reg = it->reg;
+#if defined(PDXE_ENABLE_TEST_SEAMS)
+    if (reg->reference_scan) {
+        int count = live_kind_is_type(it->kind) ? reg->type_count : reg->func_count;
