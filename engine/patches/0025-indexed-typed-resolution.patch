+                entry_has_key(reg, it->kind, i, it->a, it->b)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+#endif
+    const int *next = live_next(reg, it->kind);
+    while (it->next >= 0) {
+        int i = it->next;
+        it->next = next[i];
+        PDXE_LOOKUP_COUNT(PDXE_LC_REGISTRY_PROBES);
+        if (i >= it->from) {
+            return i;
+        }
+    }
+    return -1;
