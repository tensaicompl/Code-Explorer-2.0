+
+static void match_open(match_iter *it, const PDXETypeRegistry *reg, int kind, const char *a,
+                       const char *b, int from) {
+    it->reg = reg;
+    it->kind = kind;
+    it->a = a;
+    it->b = b;
+    it->from = from;
+#if defined(PDXE_ENABLE_TEST_SEAMS)
+    if (reg->reference_scan) {
+        it->next = from;
+        return;
+    }
+#endif
+    it->next = live_head(reg, kind, a, b);
