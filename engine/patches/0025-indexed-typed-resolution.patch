+            if (x->slots[at].first >= 0) {
+                slots[pdxe_site_slot(slots, cap, x->slots[at].start, x->slots[at].end)] =
+                    x->slots[at];
+            }
+        }
+        x->slots = slots;
+        x->cap = cap;
+    }
+    PDXESiteSlot *slot = &x->slots[pdxe_site_slot(x->slots, x->cap, start, end)];
+    if (slot->first < 0) {
+        slot->start = start;
+        slot->end = end;
+        slot->first = i;
+        x->used++;
+    } else {
+        x->next[slot->last] = i;
+    }
+    slot->last = i;
