+static bool rust_qualifier_read(RustLSPContext *ctx, const char *path, RustQualifier *out) {
+    char **q = NULL;
+    int qn = rust_split_path(ctx->arena, path, &q) - 1; /* the last is the function */
+    if (qn < 0)
