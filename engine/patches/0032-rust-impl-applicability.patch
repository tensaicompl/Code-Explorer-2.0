+        return;
+    }
+    if (ib->param_count == ib->param_cap) {
+        int cap = ib->param_cap ? ib->param_cap * 2 : 8;
+        const char **grown = (const char **)pdxe_arena_alloc(ib->a, (size_t)cap * sizeof(*grown));
+        if (!grown) {
