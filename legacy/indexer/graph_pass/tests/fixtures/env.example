# Connection string for the order database.
DATABASE_URL=MUSTNOTLEAK-one

# Exported form — a dotenv file meant to be sourced rather than read by a library.
export API_TOKEN=MUSTNOTLEAK-two

# A multi-line value. The three lines below must NOT be read as variables, and
# none of them may reach code_chunks_*.
SIGNING_MATERIAL="-----BEGIN BLOCK-----
NOT_A_VAR=MUSTNOTLEAK-three
-----END BLOCK-----"

# A line with no assignment at all.
this is not a variable

LOG_LEVEL=info
